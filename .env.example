# Copy this file to ".env" and fill in your Supabase project values.
# Supabase Dashboard -> Project Settings -> API Keys
# Use the "Publishable key" (sb_publishable_...). The legacy name VITE_SUPABASE_ANON_KEY also works.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
